# docs/05_REPOSITORY_AND_COLLABORATION.md §7 참고. 실제 값은 .env(커밋 금지)에 둔다.
VITE_API_BASE_URL=http://localhost:8000
# 랜딩페이지(별도 레포 Standin). 회원가입 링크가 이 주소의 /signup 을 연다.
VITE_WEB_BASE_URL=http://localhost:5173
VITE_USE_MOCK_API=true
# 미설정 시 VITE_USE_MOCK_API를 따른다. 포즈 분석 서버만 먼저 실제로 붙일 때 false로.
VITE_USE_MOCK_POSE_API=true
VITE_APP_ENV=development

# Development/staging replay defaults ON. Explicit false stops and clears pending replay upload.
# An unset environment in a release build is treated as production by replay.
VITE_REPLAY_ENABLED=true
VITE_CAPTURE_REPLAY_ENABLED=true
VITE_CSP_RESULT_CAPTURE_ENABLED=true
# assumed is accepted only for development/staging. Does not create quality-consent evidence.
VITE_REPLAY_CONSENT_MODE=assumed
